# runtime environment mode
ENVIRONMENT=development
# api application title
PROJECT_NAME="SalesPulse — Sales Data ETL & Reporting Platform"

# database connection url
# postgresql production format: postgresql+psycopg2://user:password@localhost:5432/salespulse
# sqlite development format: sqlite:///./data/salespulse.db
DATABASE_URL=sqlite:///./data/salespulse.db

# approved frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://salespulse.vercel.app

# maximum upload bytes (50mb)
MAX_UPLOAD_SIZE_BYTES=52428800

# frontend api target
VITE_API_BASE_URL=http://localhost:8000/api
