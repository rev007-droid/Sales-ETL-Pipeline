# node modules dependencies
node_modules/
frontend/node_modules/

# frontend build output
frontend/dist/
frontend/dist-ssr/
*.local

# test cache folders
.pytest_cache/
.coverage
htmlcov/

# editor preferences folders
.vscode/
.idea/
*.swp
*.swo

# os generated files
.DS_Store
Thumbs.db

# runtime log files
logs/*.log
!logs/.gitkeep
