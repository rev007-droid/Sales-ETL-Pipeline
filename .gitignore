# python bytecode files
__pycache__/
*.py[cod]
*$py.class

# environment variables secret
.env
.env.local
.env.*.local

# virtual environments folders
venv/
.venv/
env/
ENV/

# database storage files
data/*.db
data/salespulse.db
*.sqlite
*.sqlite3

